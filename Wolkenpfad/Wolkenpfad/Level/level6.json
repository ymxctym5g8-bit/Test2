 "texts": [
  {
   "at": [
    3,
    0,
    3
   ],
   "text": "The grass here is taller than Hana. It whispers as she passes."
  },
  {
   "at": [
    2,
    0,
    1
   ],
   "text": "Two stalks breathe in and out, slow as sleeping giants."
  },
  {
   "at": [
    4,
    3,
    0
   ],
   "text": "Hana hums the lullaby carved in the stone. Somewhere, a kodama yawns."
  },
  {
   "at": [
    0,
    5,
    -1
   ],
   "text": "Grandfather's notes: 'Let the tall one bow, and the log will roll.'"
  },
  {
   "at": [
    -1,
    5,
    -2
   ],
   "text": "A second song. Far below, a little spirit shuffles aside."
  },
  {
   "at": [
    4,
    0,
    1
   ],
   "text": "The last kodama gets up from the bell and tilts its head."
  }
 ],
