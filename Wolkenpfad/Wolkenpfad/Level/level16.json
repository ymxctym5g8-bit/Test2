   ],
   "text": "At night the islands remember. Grandfather walks here as a gentle light."
  },
  {
   "at": [
    3,
    0,
    5
   ],
   "text": "A memory stone: his laugh, as warm as bread from the oven."
  },
  {
   "at": [
    3,
    0,
    -4
   ],
   "text": "The path appears the way a name comes back – all at once."
  },
  {
   "at": [
    -3,
    3,
    -4
   ],
   "text": "The attic, years ago. A small girl asleep among the maps."
  },
  {
   "at": [
    -7,
    3,
    -7
   ],
   "text": "This door led somewhere once. It still remembers where."
  },
  {
   "at": [
    -6,
    5,
    -4
   ],
   "text": "The lantern shows what was. Hana walks where it shines."
  },
  {
   "at": [
    0,
    5,
    0
   ],
   "text": "'Every wind I mended,' he says, 'I mended for you.'"
  }
 ],
