   ],
   "text": "Hammers ring somewhere above. Someone is still mending the sky."
  },
  {
   "at": [
    1,
    0,
    3
   ],
   "text": "Every machine here is married to another. None moves alone."
  },
  {
   "at": [
    4,
    3,
    -3
   ],
   "text": "A shelf of tools, each one labelled in Grandfather's hand."
  },
  {
   "at": [
    -1,
    3,
    -3
   ],
   "text": "The great gear turns the swing bridge, slow as an old song."
  },
  {
   "at": [
    -6,
    3,
    -3
   ],
   "text": "The hoist's counterweight only rests when the hoist is high."
  },
  {
   "at": [
    -4,
    6,
    -5
   ],
   "text": "'Your grandfather built half of these,' the old woman laughs."
