   ],
   "text": "The lake lies so still that the sky forgets which way is up."
  },
  {
   "at": [
    6,
    0,
    2
   ],
   "text": "Glass panes drift on the water. Only one of them is mine."
  },
  {
   "at": [
    -1,
    0,
    2
   ],
   "text": "Barefoot on the sky, I can hear the glass humming."
  },
  {
   "at": [
    -1,
    3,
    1
   ],
   "text": "I stepped into the reflection, and it held me."
  },
  {
   "at": [
    -4,
    4,
    0
   ],
   "text": "Grandfather wrote: light hides where the water looks up."
  },
  {
   "at": [
    -3,
    6,
    -4
   ],
   "text": "Up here the lake is a mirror, and the mirror is a door."
  }
