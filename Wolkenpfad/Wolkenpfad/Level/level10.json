 "texts": [
  {
   "at": [
    -3,
    0,
    1
   ],
   "text": "Evening in the town of bellflowers. Every lamp here is a blossom."
  },
  {
   "at": [
    0,
    0,
    2
   ],
   "text": "A bell rings beneath my feet. Somewhere an old flower stirs."
  },
  {
   "at": [
    3,
    0,
    2
   ],
   "text": "Each stem holds two petals: one for the street, one for the roofs."
  },
  {
   "at": [
    5,
    2,
    0
   ],
   "text": "From the rooftops the turning stems look like a slow blue clock."
  },
  {
   "at": [
    -3,
    4,
    -8
   ],
   "text": "Grandfather wrote: the town still sings, if someone listens."
  },
  {
   "at": [
    0,
    4,
    -6
   ],
   "text": "The old bellflower waits for every bell, and for the crown to bow."
  }
 ],
